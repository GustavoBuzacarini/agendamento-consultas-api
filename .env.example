# Copie para .env e preencha. Nunca versione o .env.
POSTGRES_DB=agendamento
POSTGRES_USER=agendamento
POSTGRES_PASSWORD=
# Login (fase 2). JWT_SECRET: no mínimo 32 caracteres, aleatório e secreto (a aplicação não inicia sem ele).
JWT_SECRET=
# Documentação da API (Swagger UI). Padrão: fechada (exige token). true = abre sem token; só em ambiente local.
DOCUMENTACAO_ABERTA=false
# Primeira conta da recepção (criada na primeira subida; senha de 8 a 72 caracteres)
RECEPCAO_USUARIO_INICIAL=recepcao
RECEPCAO_SENHA_INICIAL=
# Usadas pela aplicação (application.yml)
DB_URL=jdbc:postgresql://localhost:5432/agendamento
DB_USER=agendamento
DB_PASSWORD=
